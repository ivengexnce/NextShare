# ─── NextShare Backend Environment Configuration ──────────────────────────────
# Copy this file to .env and customize values for your deployment.

# ─── Server Environment ────────────────────────────────────────────────────────
# In production on Render, set NODE_ENV=production and PORT=10000
NODE_ENV=production
PORT=10000

# ─── Database & Caching ────────────────────────────────────────────────────────
# MongoDB Atlas Connection String (Required in Production)
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/nextshare?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/nextshare?retryWrites=true&w=majority

# Redis Cache URL (Optional — if omitted, runs in direct-db resilient mode)
# e.g., rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=

# ─── File Storage & Uploads ────────────────────────────────────────────────────
# Directory where uploaded files are stored
UPLOAD_DIR=./uploads
# Maximum allowed file size in bytes (Default: 52428800 = 50 MB)
MAX_FILE_SIZE=52428800

# ─── Host, CORS & Domain Whitelist ─────────────────────────────────────────────
# Base URL of the backend service (Render URL in production)
BASE_URL=https://nextshare-api.onrender.com

# Frontend origin allowed for CORS (Vercel URL)
# Multiple origins can be comma-separated: https://nextsharebymeet.vercel.app,http://localhost:5173
CORS_ORIGIN=https://nextsharebymeet.vercel.app
FRONTEND_URL=https://nextsharebymeet.vercel.app

# ─── Security & Cryptographic Secrets ──────────────────────────────────────────
# Admin secret used to authenticate the admin panel (must not be dev-admin-secret)
ADMIN_SECRET=generate-a-strong-secret-key-here

# JWT signing secret (minimum 32 characters)
JWT_SECRET=generate-a-random-32-char-jwt-secret-key

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# 15 minutes window in milliseconds (900,000 ms)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per IP in the window
RATE_LIMIT_MAX=100
