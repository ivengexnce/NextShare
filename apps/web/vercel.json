{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(favicon.*|icon-.*|apple-touch-icon.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(og-image\\.(?:jpg|png))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://nextshare-0cy3.onrender.com/api/:path*" },
    { "source": "/s/:code", "destination": "https://nextshare-0cy3.onrender.com/:code" },
    { "source": "/r/:code", "destination": "https://nextshare-0cy3.onrender.com/:code" },
    { "source": "/f/:code", "destination": "https://nextshare-0cy3.onrender.com/api/files/:code/download" },
    { "source": "/d/:code", "destination": "https://nextshare-0cy3.onrender.com/api/files/:code/download" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/admin", "destination": "/app.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/p/:path*", "destination": "/app.html" },
    { "source": "/paste/:path*", "destination": "/app.html" }
  ]
}
