{
  "root": true,
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["apps/api/**/*.js"],
      "env": {
        "node": true,
        "commonjs": true
      },
      "parserOptions": {
        "sourceType": "script"
      }
    },
    {
      "files": ["apps/web/**/*.{js,jsx}"],
      "env": {
        "browser": true
      },
      "parserOptions": {
        "ecmaFeatures": {
          "jsx": true
        },
        "sourceType": "module"
      },
      "plugins": ["react"],
      "rules": {
        "react/prop-types": "off",
        "react/react-in-jsx-scope": "off"
      }
    }
  ]
}
